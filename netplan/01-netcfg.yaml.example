# Ziel: /etc/netplan/01-netcfg.yaml  (Rechte: sudo chmod 600)
# LAN wird bevorzugt, WLAN dient als Fallback.
# "optional: true" verhindert, dass der Boot auf ein fehlendes Netz wartet.
network:
  version: 2
  renderer: networkd
  ethernets:
    enp1s0:
      dhcp4: true
      optional: true
      dhcp4-overrides:
        route-metric: 100
  wifis:
    wlan0:
      dhcp4: true
      optional: true
      dhcp4-overrides:
        route-metric: 600
      access-points:
        "<SSID>":
          password: "<WLAN-PASSWORT>"
