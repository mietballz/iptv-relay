# ---------------------------------------------------------------
# IPTV-Relay – zentrale Konfiguration
# Kopieren nach: ~/.config/iptv-relay/iptv-relay.env
# ---------------------------------------------------------------

# Multicast-Quelle. Das "@" ist wichtig: Es sorgt dafür, dass ffplay
# der Multicast-Gruppe beitritt (IGMP Join), statt auf Unicast zu lauschen.
STREAM_URL="udp://@224.x.x.x:5000"

# PulseAudio-Sink für den HDMI-Ausgang.
# Verfügbare Sinks anzeigen: pactl list sinks short
HDMI_SINK="alsa_output.pci-0000_00_1f.3.hdmi-stereo"

# Lautstärke: SDL-intern (0-100) und zusätzlicher Verstärkungsfaktor
FFPLAY_VOLUME="100"
AUDIO_GAIN="2"

# Fenstertitel – hilft bei der Prozessidentifikation
WINDOW_TITLE="IPTV"

# Name des systemd User-Service (wird vom Watchdog geprüft)
SERVICE_NAME="iptv-relay.service"

# Netzwerk-Interfaces in Prioritätsreihenfolge (LAN vor WLAN)
INTERFACES="enp1s0 eth0 wlan0"

# Watchdog: Anzahl Netzwerk-Prüfungen und Pause dazwischen (Sekunden)
MAX_RETRIES="3"
RETRY_DELAY="5"

# Log-Verzeichnis
LOG_DIR="${HOME}/.local/state/iptv-relay"
